{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "uploadNowJson": true,
  "framework": "services",
  "services": {
    "backend": {
      "root": "backend/",
      "entrypoint": "pyproject.toml"
    },
    "frontend": {
      "root": "frontend/",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
