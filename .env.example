# --- AI provider (required) -------------------------------------------------
# Groq (https://console.groq.com/keys). Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=gsk_your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3-32b

# --- Server ----------------------------------------------------------------
# Only needed when the frontend and API are on DIFFERENT domains.
# Comma-separated frontend origins. Same-origin deploys need nothing here.
# ALLOWED_ORIGINS=https://my-app.vercel.app,https://www.example.com

# Host/port. Platforms inject PORT automatically; leave as-is unless needed.
# PORT=8000
# HOST=0.0.0.0

# Where the built frontend lives, when the API also serves it.
# Auto-detected for a local checkout and set by the Dockerfile. Set manually
# only if you build the frontend yourself and keep it outside the repo.
# STATIC_DIR=./frontend/dist

# --- Frontend (build time) -------------------------------------------------
# Leave empty for same-origin (Docker, Vercel services).
# Set to the API origin only if the frontend is hosted separately, e.g.
# VITE_API_BASE_URL=https://fraudshield-api.onrender.com
